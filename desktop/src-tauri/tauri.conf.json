{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Continuity",
  "version": "0.4.1",
  "identifier": "com.neonet.codexcontinuity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Continuity",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Neonet",
    "copyright": "Copyright © 2026 Neonet",
    "category": "DeveloperTool",
    "shortDescription": "在多台电脑之间安全延续 Codex 会话上下文",
    "longDescription": "Codex Continuity 通过本机加密、私有服务器存储、离线队列和桌面托盘，在多台电脑之间安全同步 Codex 会话快照并延续工作上下文。",
    "externalBin": [
      "binaries/continuity-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
